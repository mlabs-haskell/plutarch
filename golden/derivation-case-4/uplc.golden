\ ->
  let mArg_wy = \xy yy zy ->
                  case yy
                    [ case zy
                        [ (True :: Bool)
                        , \unused_az unused_bz -> (False :: Bool)
                        ]
                    , \cz dz ->
                        case zy
                          [ (False :: Bool)
                          , \ez fz ->
                              case 
                                (case (constr 0 [xy, dz, fz]) [xy])
                                [(False :: Bool), EqualsInteger # cz # ez]
                          ]
                    ]
  in case 
       (constr 0
         [ mArg_wy
         , constr 0 []
         , constr 1
             [ (3 :: Integer)
             , constr 1 [(2 :: Integer), constr 1 [(1 :: Integer), constr 0 []]]
             ]
         ]
       )
       [mArg_wy]