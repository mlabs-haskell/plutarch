\ ->
  let mArg_yy = \zy az bz ->
                  case az
                    [ case bz
                        [ (True :: Bool)
                        , \unused_cz unused_dz -> (False :: Bool)
                        ]
                    , \ez fz ->
                        case bz
                          [ (False :: Bool)
                          , \gz hz ->
                              case 
                                (case (constr 0 [zy, fz, hz]) [zy])
                                [(False :: Bool), EqualsInteger # ez # gz]
                          ]
                    ]
  in case 
       (constr 0
         [ mArg_yy
         , constr 0 []
         , constr 1
             [ (3 :: Integer)
             , constr 1 [(2 :: Integer), constr 1 [(1 :: Integer), constr 0 []]]
             ]
         ]
       )
       [mArg_yy]