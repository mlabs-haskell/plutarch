let mArg_wy = \xy yy zy ->
                case yy
                  [ case zy
                      [(True :: Bool), \unused_az unused_bz -> (False :: Bool)]
                  , \cz dz ->
                      case zy
                        [ (False :: Bool)
                        , \ez fz ->
                            case
                              (xy # xy # dz # fz)
                              [(False :: Bool), EqualsInteger # cz # ez]
                        ]
                  ]
in mArg_wy
   # mArg_wy
   # (constr 0 [])
   # (constr 1
       [ (3 :: Integer)
       , constr 1 [(2 :: Integer), constr 1 [(1 :: Integer), constr 0 []]]
       ]
     )