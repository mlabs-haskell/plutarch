                    let bind_cw = ([3, 6, 9] :: Array Integer)
                    in (\dw ->
                         (\ew fw ->
                           fw
                           # (
                               (\cse_gw ->
                                 case
                                   (LessThanEqualsInteger # cse_gw # dw)
