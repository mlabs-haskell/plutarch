let bind_j = ("cat goes nya" :: Bytestring)
in let bind_k = LengthOfByteString # bind_j
   in case
        (EqualsInteger # bind_k # (0 :: Integer))
        [ AppendString
          # ( AppendString
              # ("[" :: String)
              # (
                  ( (\mArg_f -> mArg_f # mArg_f)
                    # (\a b c d ->
                        let bind_ib = \e ->
                                        case e
                                          [ ("0" :: String)
                                          , ("1" :: String)
                                          , ("2" :: String)
                                          , ("3" :: String)
                                          , ("4" :: String)
                                          , ("5" :: String)
                                          , ("6" :: String)
                                          , ("7" :: String)
                                          , ("8" :: String)
                                          , ("9" :: String)
                                          , ("A" :: String)
                                          , ("B" :: String)
                                          , ("C" :: String)
                                          , ("D" :: String)
                                          , ("E" :: String)
                                          , ("F" :: String)
                                          ]
                            bind_lb = IndexByteString # b # d
                        in let bind_tb = AppendString
                                         # ( AppendString
                                             # ("0x" :: String)
                                             # ( bind_ib
                                                 # ( QuotientInteger
                                                     # bind_lb
                                                     # (16 :: Integer)
                                                   )
                                               )
                                           )
                                         # ( bind_ib
                                             # ( RemainderInteger
                                                 # bind_lb
                                                 # (16 :: Integer)
                                               )
                                           )
                           in case
                                (EqualsInteger # c # d)
                                [ AppendString
                                  # (AppendString # bind_tb # (", " :: String))
                                  # ( (a # a)
                                      # b
                                      # c
                                      # (AddInteger # d # (1 :: Integer))
                                    )
                                , bind_tb
                                ]
                      )
                  )
                  # bind_j
                  # (SubtractInteger # bind_k # (1 :: Integer))
                  # (0 :: Integer)
                )
            )
          # ("]" :: String)
        , ("[]" :: String)
        ]