let bind_ek = \jk kk -> case jk [case kk [(True :: Bool), (False :: Bool)], kk]
    bind_fk = ([] :: [Data])
    bind_gk = \hk unused_ik -> case hk [(False :: Bool), (True :: Bool)]
in case
     ( bind_ek
       # (
           case
             (UnConstrData # (ConstrData # (1 :: Integer) # bind_fk))
             [bind_gk]
         )
       # (True :: Bool)
     )
     [ (False :: Bool)
     , bind_ek
       # (
           case
             (UnConstrData # (ConstrData # (0 :: Integer) # bind_fk))
             [bind_gk]
         )
       # (False :: Bool)
     ]