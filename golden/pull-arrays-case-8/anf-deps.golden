ANF Binds:
 #0 := LengthOfArray
 #1 := Force #0
 #2 := [1, 2, 3] :: Array Integer
 #3 := Apply #1 [#2]
 #4 := IndexArray
 #5 := Force #4
 #6 := Apply #5 [#2]
 #7 := Apply a [#3, #6]
 #8 := \a:1 -> #7
 #9 := AddInteger
 #10 := 1 :: Integer
 #11 := Apply #9 [f, #10]
 #12 := \f:1 -> #11
 #13 := Apply #12 [e]
 #14 := Apply #9 [#13, #13]
 #15 := \e:1 -> #14
 #16 := #15 <<< c
 #17 := Apply d [b, #16]
 #18 := \b:1 c:1 d:1 -> #17
 #19 := Apply #8 [#18]

ANF Annotations:
 #0 := No dependencies
 #1 := Direct: {#0}, indirect: {}
 #2 := No dependencies
 #3 := Direct: {#1, #2}, indirect: {#0}
 #4 := No dependencies
