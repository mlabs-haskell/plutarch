(
  fix (\a_self b c ->
        case 
          (UnConstrData # b)
          [ \d e ->
              case e
                [ \f g ->
                    case d
                      [ let _ = UnIData # f in case g [\_ _ -> ERROR, c]
                      , let _ = UnIData # f
                        in case g
                             [\h i -> a_self # h # (case i [\_ _ -> ERROR, c])]
                      ]
                ]
          ]
      )
)
# (
    ConstrData
    # 1 :: Integer
    # (
        !MkCons
        # (IData # 1 :: Integer)
        # (
            !MkCons
            # (
                ConstrData
                # 0 :: Integer
                # (!MkCons # (IData # 2 :: Integer) # [] :: [Data])
              )
            # [] :: [Data]
          )
      )
  )
# (
    ConstrData
    # 1 :: Integer
    # (
        !MkCons
        # (IData # 1 :: Integer)
        # (
            !MkCons
            # (
                ConstrData
                # 0 :: Integer
                # (!MkCons # (IData # 2 :: Integer) # [] :: [Data])
              )
            # [] :: [Data]
          )
      )
  )