 (
   fix (\a_self b c ->
         case 
           (UnConstrData # b)
           [ \d e ->
               case e
                 [ \f g ->
                     case d
                       [ (\_ -> case g [\_ _ -> ERROR, c]) # (UnIData # f)
                       ,  (\_ ->
                            case g
                              [\h i -> a_self # h # (case i [\_ _ -> ERROR, c])]
                          )
                          # (UnIData # f) 
                       ]
                 ]
           ]
       )
 )
