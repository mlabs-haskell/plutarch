ANF Binds:
 #0 := LengthOfArray
 #1 := Force #0
 #2 := [1, 2, 3] :: Array Integer
 #3 := Apply #1 [#2]
 #4 := IndexArray
 #5 := Force #4
 #6 := Apply #5 [#2]
 #7 := Apply a [#3, #6]
 #8 := \a:1 -> #7
 #9 := LessThanEqualsInteger
 #10 := Apply #9 [b, e]
 #11 := Case #10 [e, b]
 #12 := AddInteger
 #13 := Apply c [h]
 #14 := Apply f [h]
 #15 := Apply #12 [#13, #14]
 #16 := \h:2 -> #15
 #17 := Apply g [#11, #16]
 #18 := \e:2 f:1 g:1 -> #17
 #19 := Apply #8 [#18]
 #20 := \b:2 c:1 -> #19
 #21 := Apply #8 [#20]

