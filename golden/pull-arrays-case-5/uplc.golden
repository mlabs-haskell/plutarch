(
  let forced_ht = !LengthOfArray
  in \forced_it ->
       let bind_os = ([1, 2, 3] :: Array Integer)
       in let bind_ps = \ws ->
                          ws # (forced_ht # bind_os) # (forced_it # bind_os)
          in bind_ps
             # (\qs rs ->
                 bind_ps
                 # (\ss ts us ->
                     us
                     # (case (LessThanEqualsInteger # qs # ss) [ss, qs])
                     # (\vs -> AddInteger # (rs # vs) # (ts # vs))
                   )
               )
)
# !IndexArray