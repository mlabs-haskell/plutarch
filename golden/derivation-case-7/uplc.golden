let bind_s = <(", " :: String)>
    bind_gb = <("0" :: String)>
    bind_hb = <("1" :: String)>
    bind_ib = <("2" :: String)>
    bind_jb = <("3" :: String)>
    bind_kb = <("4" :: String)>
    bind_lb = <("5" :: String)>
    bind_mb = <("6" :: String)>
    bind_nb = <("7" :: String)>
    bind_ob = <("8" :: String)>
    bind_pb = <("9" :: String)>
    bind_lc = <("\n" :: String)>
    bind_oc = <("}" :: String)>
in case
     (constr 0 [(2 :: Integer)])
     [ \a ->
         AppendString
         # ("PLeft {\n" :: String)
         # ( AppendString
             # ( AppendString
                 # !bind_s
                 # ( AppendString
                     # (
                         let bind_wb = <(\mArg_f -> mArg_f # mArg_f)
                                        # (\b c d ->
                                            let bind_sb = <(\e ->
                                                             case e
                                                               [ !bind_gb
                                                               , !bind_hb
                                                               , !bind_ib
                                                               , !bind_jb
                                                               , !bind_kb
                                                               , !bind_lb
                                                               , !bind_mb
                                                               , !bind_nb
                                                               , !bind_ob
                                                               , !bind_pb
                                                               ]
                                                           )
                                                           # d>
                                            in case
                                                 ( EqualsInteger
                                                   # c
                                                   # (0 :: Integer)
                                                 )
                                                 [ AppendString
                                                   # ( b
                                                       # b
                                                       # ( QuotientInteger
                                                           # c
                                                           # (10 :: Integer)
                                                         )
                                                       # ( RemainderInteger
                                                           # c
                                                           # (10 :: Integer)
                                                         )
                                                     )
                                                   # !bind_sb
                                                 , !bind_sb
                                                 ]
                                          )>
                         in case
                              (LessThanEqualsInteger # a # (-1 :: Integer))
                              [ case
                                  (EqualsInteger # a # (0 :: Integer))
                                  [ !bind_wb
                                    # (QuotientInteger # a # (10 :: Integer))
                                    # (RemainderInteger # a # (10 :: Integer))
                                  , !bind_gb
                                  ]
                              , AppendString
                                # ("-" :: String)
                                # (
                                    let bind_dc = <SubtractInteger
                                                   # (0 :: Integer)
                                                   # a>
                                    in case
                                         ( EqualsInteger
                                           # !bind_dc
                                           # (0 :: Integer)
                                         )
                                         [ !bind_wb
                                           # ( QuotientInteger
                                               # !bind_dc
                                               # (10 :: Integer)
                                             )
                                           # ( RemainderInteger
                                               # !bind_dc
                                               # (10 :: Integer)
                                             )
                                         , !bind_gb
                                         ]
                                  )
                              ]
                       )
                     # !bind_lc
                   )
               )
             # !bind_oc
           )
     , \l ->
         AppendString
         # ("PRight {\n" :: String)
         # ( AppendString
             # ( AppendString
                 # !bind_s
                 # ( AppendString
                     # (
                         let bind_uc = <LengthOfByteString # l>
                         in case
                              (EqualsInteger # !bind_uc # (0 :: Integer))
                              [ AppendString
                                # ( AppendString
                                    # ("[" :: String)
                                    # (
                                        ( (\mArg_g -> mArg_g # mArg_g)
                                          # (\m n o p ->
                                              let bind_gd = <\q ->
                                                               case q
                                                                 [ !bind_gb
                                                                 , !bind_hb
                                                                 , !bind_ib
                                                                 , !bind_jb
                                                                 , !bind_kb
                                                                 , !bind_lb
                                                                 , !bind_mb
                                                                 , !bind_nb
                                                                 , !bind_ob
                                                                 , !bind_pb
                                                                 , ("A" :: String)
                                                                 , ("B" :: String)
                                                                 , ("C" :: String)
                                                                 , ("D" :: String)
                                                                 , ("E" :: String)
                                                                 , ("F" :: String)
                                                                 ]>
                                                  bind_id = <IndexByteString
                                                             # n
                                                             # p>
                                              in let bind_pd = <AppendString
                                                                # ( AppendString
                                                                    # ("0x" :: String)
                                                                    # ( !bind_gd
                                                                        # (
                                                                            QuotientInteger
                                                                            # !bind_id
                                                                            # (16 :: Integer)
                                                                          )
                                                                      )
                                                                  )
                                                                # ( !bind_gd
                                                                    # (
                                                                        RemainderInteger
                                                                        # !bind_id
                                                                        # (16 :: Integer)
                                                                      )
                                                                  )>
                                                 in case
                                                      (EqualsInteger # o # p)
                                                      [ AppendString
                                                        # ( AppendString
                                                            # !bind_pd
                                                            # !bind_s
                                                          )
                                                        # ( (m # m)
                                                            # n
                                                            # o
                                                            # ( AddInteger
                                                                # p
                                                                # (1 :: Integer)
                                                              )
                                                          )
                                                      , !bind_pd
                                                      ]
                                            )
                                        )
                                        # l
                                        # ( SubtractInteger
                                            # !bind_uc
                                            # (1 :: Integer)
                                          )
                                        # (0 :: Integer)
                                      )
                                  )
                                # ("]" :: String)
                              , ("[]" :: String)
                              ]
                       )
                     # !bind_lc
                   )
               )
             # !bind_oc
           )
     ]