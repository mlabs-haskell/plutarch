case 
  (constr 0
    [ AppendString
    , \a ->
        case a
          [ ("0" :: String)
          , ("1" :: String)
          , ("2" :: String)
          , ("3" :: String)
          , ("4" :: String)
          , ("5" :: String)
          , ("6" :: String)
          , ("7" :: String)
          , ("8" :: String)
          , ("9" :: String)
          , ("A" :: String)
          , ("B" :: String)
          , ("C" :: String)
          , ("D" :: String)
          , ("E" :: String)
          , ("F" :: String)
          ]
    , (31 :: Integer)
    , (16 :: Integer)
    ]
  )
  [ \bind_c bind_v bind_x bind_y ->
      AppendString
      # (
          AppendString
          # ("0x" :: String)
          # (bind_v # (QuotientInteger # (31 :: Integer) # (16 :: Integer)))
        )
      # (bind_v # (RemainderInteger # (31 :: Integer) # (16 :: Integer)))
  ]