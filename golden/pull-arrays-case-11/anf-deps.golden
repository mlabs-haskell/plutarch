ANF Binds:
 #0 := LengthOfArray
 #1 := Force #0
 #2 := [1, 2, 3] :: Array Integer
 #3 := Apply #1 [#2]
 #4 := IndexArray
 #5 := Force #4
 #6 := Apply #5 [#2]
 #7 := Apply a [#3, #6]
 #8 := \a:1 -> #7
 #9 := MultiplyInteger
 #10 := Apply c [e]
 #11 := Apply #9 [e, #10]
 #12 := \e:2 -> #11
 #13 := Apply d [b, #12]
 #14 := \b:1 c:1 d:1 -> #13
 #15 := Apply #8 [#14]

ANF Annotations:
 #0 := No dependencies
 #1 := Direct: {#0}, indirect: {}
 #2 := No dependencies
 #3 := Direct: {#1, #2}, indirect: {#0}
 #4 := No dependencies
 #5 := Direct: {#4}, indirect: {}
 #6 := Direct: {#2, #5}, indirect: {#4}
 #7 := Direct: {#3, #6}, indirect: {#0, #1, #2, #4, #5}
 #8 := Direct: {#7}, indirect: {#0, #1, #2, #3, #4, #5, #6}
 #9 := No dependencies
 #10 := No dependencies
 #11 := Direct: {#9, #10}, indirect: {}
 #12 := Direct: {#11}, indirect: {#9, #10}
 #13 := Direct: {#12}, indirect: {#9, #10, #11}
 #14 := Direct: {#13}, indirect: {#9, #10, #11, #12}
 #15 := Direct: {#8, #14}, indirect: { #0
