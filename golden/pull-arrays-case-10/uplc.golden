(
  let forced_gn = !LengthOfArray
  in \forced_hn ->
       let bind_vm = ([1, 2, 3] :: Array Integer)
       in (\wm ->
            (\mArg_xm -> mArg_xm # mArg_xm # (0 :: Integer))
            # (\ym zm ->
                case
                  (EqualsInteger # zm # wm)
                  [ (\an ->
                      (\bn -> AddInteger # (MultiplyInteger # an # an) # bn)
                      # (ym # ym # (AddInteger # zm # (1 :: Integer)))
                    )
                    # (forced_hn # bind_vm # zm)
                  , (5 :: Integer)
                  ]
              )
          )
          # (forced_gn # bind_vm)
)
# !IndexArray