ANF Binds:
 #0 := LengthOfArray
 #1 := Force #0
 #2 := [1, 2, 3] :: Array Integer
 #3 := Apply #1 [#2]
 #4 := IndexArray
 #5 := Force #4
 #6 := Apply #5 [#2]
 #7 := Apply a [#3, #6]
 #8 := \a:1 -> #7
 #9 := AddInteger
 #10 := 1 :: Integer
 #11 := Apply #9 [e, #10]
 #12 := \e:1 -> #11
 #13 := #12 <<< c
 #14 := Apply d [b, #13]
 #15 := \b:1 c:1 d:1 -> #14
 #16 := LessThanEqualsInteger
 #17 := Apply #16 [f, m]
 #18 := Case #17 [m, f]
 #19 := Apply g [p]
 #20 := Apply n [p]
 #21 := Apply #9 [#19, #20]
 #22 := \p:2 -> #21
 #23 := Apply o [#18, #22]
 #24 := \m:2 n:1 o:1 -> #23
 #25 := Apply #8 [#15, #24]
 #26 := \f:2 g:1 -> #25
 #27 := Apply #8 [#15, #26]

