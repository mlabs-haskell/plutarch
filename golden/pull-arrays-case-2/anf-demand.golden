ANF Binds:
 #0 := LengthOfArray
 #1 := Force #0
 #2 := [1, 2, 3] :: Array Integer
 #3 := Apply #1 [#2]
 #4 := IndexArray
 #5 := Force #4
 #6 := Apply #5 [#2]
