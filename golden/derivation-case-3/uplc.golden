\xu yu ->
  let bind_zu = \unused_lv -> (False :: Bool)
  let bind_av = \unused_jv unused_kv -> (False :: Bool)
  in case 
       (constr 0
         [ \bv ->
             case 
               (constr 0 [\cv -> EqualsInteger # bv # cv, bind_zu, bind_av])
               [yu]
         , \dv ->
             case 
               (constr 0 [bind_zu, \ev -> EqualsInteger # dv # ev, bind_av])
               [yu]
         , \fv gv ->
             case 
               (constr 0
                 [ bind_zu
                 , bind_zu
                 , \hv iv ->
                     case 
                       (EqualsInteger # fv # hv)
                       [(False :: Bool), EqualsInteger # gv # iv]
                 ]
               )
               [yu]
         ]
       )
       [xu]