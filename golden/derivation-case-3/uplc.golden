\tx ux ->
  let bind_vx = \unused_iy unused_jy -> (False :: Bool)
  in case 
       (constr 0
         [ \wx ->
             case 
               (constr 0
                 [ \xx -> EqualsInteger # wx # xx
                 , \unused_yx -> (False :: Bool)
                 , bind_vx
                 ]
               )
               [ux]
         , \zx ->
             case 
               (constr 0
                 [ \unused_ay -> (False :: Bool)
                 , \by -> EqualsInteger # zx # by
                 , bind_vx
                 ]
               )
               [ux]
         , \cy dy ->
             case 
               (constr 0
                 [ \unused_ey -> (False :: Bool)
                 , \unused_fy -> (False :: Bool)
                 , \gy hy ->
                     case 
                       (EqualsInteger # cy # gy)
                       [(False :: Bool), EqualsInteger # dy # hy]
                 ]
               )
               [ux]
         ]
       )
       [tx]