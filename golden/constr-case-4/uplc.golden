let bind_t = <!HeadList>
in case
     ( ConstrData
       # (2 :: Integer)
       # (
           let bind_i = !MkCons
           in bind_i
              # (IData # (1 :: Integer))
              # (bind_i # (IData # (2 :: Integer)) # ([] :: [Data]))
         )
     )
     [ \a -> UnIData # (!bind_t # a)
     , \a -> UnIData # (!bind_t # a)
     , \c ->
         case c [\d e -> AddInteger # (UnIData # d) # (UnIData # (!bind_t # e))]
     ]