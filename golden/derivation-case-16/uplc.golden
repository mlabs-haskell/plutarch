let bind_q = <!MkCons>
    bind_w = <([] :: [Data])>
in let bind_x = <ConstrData
                 # (case (False :: Bool) [(0 :: Integer), (1 :: Integer)])
                 # !bind_w>
   in let bind_bb = <ListData
                     # ( !bind_q
                         # !bind_x
                         # (!bind_q # !bind_x # (!bind_q # !bind_x # !bind_w))
                       )>
      in case
           (UnListData # !bind_bb)
           [ \a b ->
               case
                 (UnConstrData # a)
                 [ \c d ->
                     let bind_gb = <\unused_e unused_e -> ERROR>
                     in case d
                          [ !bind_gb
                          , case c
                              [ case b
                                  [ \g h ->
                                      case
                                        (UnConstrData # g)
                                        [ \i j ->
                                            case j
                                              [ !bind_gb
                                              , case i
                                                  [ case h
                                                      [ \m n ->
                                                          case
                                                            (UnConstrData # m)
                                                            [ \o p ->
                                                                case p
                                                                  [ !bind_gb
                                                                  , case o
                                                                      [ case n
                                                                          [ !bind_gb
                                                                          , !bind_bb
                                                                          ]
                                                                      , case n
                                                                          [ !bind_gb
                                                                          , !bind_bb
                                                                          ]
                                                                      ]
                                                                  ]
                                                            ]
                                                      ]
                                                  , case h
                                                      [ \m n ->
                                                          case
                                                            (UnConstrData # m)
                                                            [ \o p ->
                                                                case p
                                                                  [ !bind_gb
                                                                  , case o
                                                                      [ case n
                                                                          [ !bind_gb
                                                                          , !bind_bb
                                                                          ]
                                                                      , case n
                                                                          [ !bind_gb
                                                                          , !bind_bb
                                                                          ]
                                                                      ]
                                                                  ]
                                                            ]
                                                      ]
                                                  ]
                                              ]
                                        ]
                                  ]
                              , case b
                                  [ \g h ->
                                      case
                                        (UnConstrData # g)
                                        [ \i j ->
                                            case j
                                              [ !bind_gb
                                              , case i
                                                  [ case h
                                                      [ \m n ->
                                                          case
                                                            (UnConstrData # m)
                                                            [ \o p ->
                                                                case p
                                                                  [ !bind_gb
                                                                  , case o
                                                                      [ case n
                                                                          [ !bind_gb
                                                                          , !bind_bb
                                                                          ]
                                                                      , case n
                                                                          [ !bind_gb
                                                                          , !bind_bb
                                                                          ]
                                                                      ]
                                                                  ]
                                                            ]
                                                      ]
                                                  , case h
                                                      [ \m n ->
                                                          case
                                                            (UnConstrData # m)
                                                            [ \o p ->
                                                                case p
                                                                  [ !bind_gb
                                                                  , case o
                                                                      [ case n
                                                                          [ !bind_gb
                                                                          , !bind_bb
                                                                          ]
                                                                      , case n
                                                                          [ !bind_gb
                                                                          , !bind_bb
                                                                          ]
                                                                      ]
                                                                  ]
                                                            ]
                                                      ]
                                                  ]
                                              ]
                                        ]
                                  ]
                              ]
                          ]
                 ]
           ]