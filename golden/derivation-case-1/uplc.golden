\xu yu ->
  let bind_zu = \unused_lv -> (False :: Bool)
  let bind_av = \unused_jv unused_kv -> (False :: Bool)
  in case xu
       [ \bv -> case yu [\cv -> EqualsInteger # bv # cv, bind_zu, bind_av]
       , \dv -> case yu [bind_zu, \ev -> EqualsInteger # dv # ev, bind_av]
       , \fv gv ->
           case yu
             [ bind_zu
             , bind_zu
             , \hv iv ->
                 case 
                   (EqualsInteger # gv # iv)
                   [(False :: Bool), EqualsInteger # fv # hv]
             ]
       ]