\ci ->
  case ci
    [ (\bind_di ->
        AddInteger # (bind_di # (10 :: Integer)) # (bind_di # (20 :: Integer))
      )
      # (\ei -> AddInteger # ei # ei)
    , (\bind_fi ->
        AddInteger # (bind_fi # (10 :: Integer)) # (bind_fi # (20 :: Integer))
      )
      # (\gi -> MultiplyInteger # gi # gi)
    ]