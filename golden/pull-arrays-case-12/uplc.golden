(\forced_ti forced_ui ->
  (\oi ->
    let bind_pi = ([1, 2, 3] :: Array Integer)
    in (\qi ri ->
         ri
         # (case (LessThanEqualsInteger # oi # qi) [qi, oi])
         # (\si -> MultiplyInteger # si # (forced_ui # bind_pi # si))
       )
       # (forced_ti # bind_pi)
  )
  # (3 :: Integer)
)
# !LengthOfArray
# !IndexArray