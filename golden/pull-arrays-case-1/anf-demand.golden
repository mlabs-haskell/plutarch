ANF Binds:
 #0 := LengthOfArray
 #1 := Force #0
 #2 := [1, 2, 3] :: Array Integer
 #3 := Apply #1 [#2]
 #4 := IndexArray
 #5 := Force #4
 #6 := Apply #5 [#2]
 #7 := Apply a [#3, #6]
 #8 := \a:1 -> #7
 #9 := AddInteger
 #10 := 1 :: Integer
 #11 := Apply #9 [e, #10]
 #12 := \e:1 -> #11
 #13 := #12 <<< c
 #14 := Apply d [b, #13]
 #15 := \b:1 c:1 d:1 -> #14
