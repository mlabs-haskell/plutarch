ANF Binds:
 #0 := LengthOfArray
 #1 := Force #0
 #2 := [1, 2, 3] :: Array Integer
 #3 := Apply #1 [#2]
 #4 := IndexArray
 #5 := Force #4
 #6 := Apply #5 [#2]
 #7 := Apply a [#3, #6]
 #8 := \a:1 -> #7
 #9 := AddInteger
 #10 := Apply #9 [e, e]
 #11 := \e:2 -> #10
 #12 := #11 <<< c
 #13 := Apply d [b, #12]
 #14 := \b:1 c:1 d:1 -> #13
 #15 := Apply #8 [#14]
