\uk vk ->
  let mArg_wk = \xk yk ->
                  case
                    (EqualsInteger # uk # (1 :: Integer))
                    [ let bind_zk = (\cse_al -> AddInteger # cse_al # cse_al)
                                    # ( xk
                                        # xk
                                        # ( QuotientInteger
                                            # yk
                                            # (2 :: Integer)
                                          )
                                      )
                      in case
                           (RemainderInteger # yk # (2 :: Integer))
                           [bind_zk, AddInteger # bind_zk # vk]
                    , vk
                    ]
  in mArg_wk # mArg_wk # uk