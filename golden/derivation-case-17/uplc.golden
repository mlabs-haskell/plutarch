let bind_j = !MkCons
in let bind_u = ConstrData
                # (2 :: Integer)
                # ( bind_j
                    # (IData # (2 :: Integer))
                    # ( bind_j
                        # (BData # ("foo" :: Bytestring))
                        # ([] :: [Data])
                      )
                  )
   in case
        (UnConstrData # bind_u)
        [ \a b ->
            case b
              [ \c d ->
                  let bind_x = \unused_e unused_e -> ERROR
                      bind_bb = <UnIData # c>
                  in let bind_z = <\unused_e -> case d [bind_x, bind_u]>
                     in case a
                          [ !bind_z # !bind_bb
                          , !bind_z # (UnBData # c)
                          , (\unused_e ->
                              case d
                                [ \l m ->
                                    (\unused_e -> case m [bind_x, bind_u])
                                    # (UnBData # l)
                                ]
                            )
                            # !bind_bb
                          ]
              ]
        ]