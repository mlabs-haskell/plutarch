\ ->
  let bind_j = !MkCons
  let bind_u = ConstrData
               # (2 :: Integer)
               # (
                   bind_j
                   # (IData # (2 :: Integer))
                   # (bind_j # (BData # ("foo" :: Bytestring)) # ([] :: [Data]))
                 )
  in case 
       (UnConstrData # bind_u)
       [ \a b ->
           case b
             [ \c d ->
                 (\bind_x ->
                   (\bind_z ->
                     (\bind_bb ->
                       case a
                         [ bind_z # bind_bb
                         , bind_z # (UnBData # c)
                         , (\unused_e ->
                             case d
                               [ \l m ->
                                   (\unused_e -> case m [bind_x, bind_u])
                                   # (UnBData # l)
                               ]
                           )
                           # bind_bb
                         ]
                     )
                     # (UnIData # c)
                   )
                   # (\unused_e -> case d [bind_x, bind_u])
                 )
                 # (\unused_e unused_e -> ERROR)
             ]
       ]