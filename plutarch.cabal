cabal-version:      3.0
name:               plutarch
version:            2.0.0
synopsis:           A Haskell eDSL for UPLC.
description:        Someday something will go here.
homepage:           https://github.com/mlabs-haskell/plutarch
license:            MIT
license-file:       LICENSE
author:             Koz Ross, Sean Hunter
maintainer:         koz@mlabs.city
bug-reports:        https://github.com/mlabs-haskell/mlabs-haskell/issues
copyright:          (C) MLabs 2026
category:           Plutarch
tested-with:        GHC ==9.8.4
build-type:         Simple
extra-source-files:
  CHANGELOG.md
  README.md

-- Common sections
common lang
  build-depends:      base ^>=4.19
  ghc-options:
    -Wall -Wcompat -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wredundant-constraints
    -Wmissing-export-lists -Wmissing-deriving-strategies
    -Wredundant-bang-patterns

  default-extensions:
    DeriveFunctor
    DerivingVia
    FlexibleContexts
    ImportQualifiedPost
    KindSignatures
    LambdaCase
    NoStarIsType
    RankNTypes
    ScopedTypeVariables
    TypeApplications
    TypeFamilies

  default-language:   Haskell2010

library
  import:          lang
  exposed-modules:
    Plutarch.Backend.PosTree
    Plutarch.Backend.RawTerm
    Plutarch.Backend.UPLC
    Plutarch.Helpers.Pretty

  build-depends:
    , bytestring
    , containers
    , hashable
    , lens
    , mtl
    , nonempty-vector
    , plutus-core      ==1.64.0.0
    , prettyprinter
    , text
    , these
    , vector

  hs-source-dirs:  src
